# Copy this file to .env and fill in your real values.
# Get these from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: this project's anon key was previously committed to git history
# (both here and in chalmers-admin/). Rotate it in the Supabase
# dashboard (Settings -> API -> reset the anon key) before relying on
# these credentials being private, then update both .env files with
# the new value.
